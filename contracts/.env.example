# Foundry deploy script config (script/Deploy.s.sol). Copy to .env and fill in from the Mezo team /
# docs before running against testnet or mainnet. NEVER commit the real .env.

# Deployer key used with --private-key on the forge script command; not read from this file directly,
# kept here only as a reminder of what the script needs.
# DEPLOYER_PRIVATE_KEY=

OWNER_ADDRESS=
RESOLVER_ADDRESS=
TREASURY_ADDRESS=

# MUSD ecosystem (see mezo-org/musd)
MUSD_ADDRESS=
BORROWER_OPERATIONS_ADDRESS=
TROVE_MANAGER_ADDRESS=
PRICE_FEED_ADDRESS=

# BTC + Mezo Pools (tigris) — see docs/SYSTEM_DESIGN.md §22 "Open Questions" for what to confirm
BTC_TOKEN_ADDRESS=
BTC_WRAP_NATIVE=false
MEZO_ROUTER_ADDRESS=
POOL_FACTORY_ADDRESS=
BTC_MUSD_STABLE_POOL=false
