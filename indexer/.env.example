# Mezo network
PONDER_RPC_URL_MEZO_TESTNET=https://rpc.test.mezo.org

# Ledger contract addresses — same values as deployments/<chainId>.json from `forge script Deploy`
INVOICE_REGISTRY_ADDRESS=
RECEIVABLE_NFT_ADDRESS=
ADVANCE_ENGINE_ADDRESS=
SETTLEMENT_ROUTER_ADDRESS=
COLLECTIONS_MANAGER_ADDRESS=
LEDGER_ACCOUNT_FACTORY_ADDRESS=

# Block the InvoiceRegistry was deployed at (avoids scanning from genesis)
INVOICE_REGISTRY_START_BLOCK=0

# Database Ponder syncs into (Postgres in production; falls back to an embedded pglite for local dev
# when unset — see https://ponder.sh/docs/database)
DATABASE_URL=
