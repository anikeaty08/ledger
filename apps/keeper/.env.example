# Mezo network
RPC_URL=https://rpc.test.mezo.org
CHAIN_ID=31611

# Ledger contracts (same addresses as apps/api/.env.example)
INVOICE_REGISTRY_ADDRESS=
COLLECTIONS_MANAGER_ADDRESS=
LEDGER_ACCOUNT_FACTORY_ADDRESS=

# Keeper's own wallet. It pays gas and receives the on-chain bounty/tip for each action it triggers
# (see docs/SYSTEM_DESIGN.md §10). It never holds user or protocol funds beyond its own gas balance.
# NEVER commit the real value.
KEEPER_PRIVATE_KEY=

# How often to sweep for overdue/defaultable invoices and guardian checks (ms).
POLL_INTERVAL_MS=60000

# Batch size per sweep (bounds gas and RPC load per tick).
BATCH_SIZE=25
