# Server
PORT=8787
NODE_ENV=development

# Mezo network
CHAIN_ID=31611
RPC_URL=https://rpc.test.mezo.org
EXPLORER_URL=https://explorer.test.mezo.org

# Ledger contract addresses (fill in after deployment — see contracts/deployments/testnet.json)
INVOICE_REGISTRY_ADDRESS=
RECEIVABLE_NFT_ADDRESS=
ADVANCE_ENGINE_ADDRESS=
SETTLEMENT_ROUTER_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
CREDIT_POLICY_ADDRESS=
SENIOR_VAULT_ADDRESS=
JUNIOR_VAULT_ADDRESS=
BTC_SWAPPER_ADDRESS=
LEDGER_ACCOUNT_FACTORY_ADDRESS=
COLLECTIONS_MANAGER_ADDRESS=
SPLITTER_FACTORY_ADDRESS=
MUSD_ADDRESS=

# Relayer: pays gas for gasless client acceptance (openTroveWithSignature-style relaying).
# Holds NO user funds or user keys — only submits payloads users already signed. Fund it with a little
# testnet BTC for gas. NEVER commit the real value; this file only documents the shape.
RELAYER_PRIVATE_KEY=

# Database (Postgres via Supabase or local)
DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger

# Invoice terms encryption: server never sees plaintext or the decryption key — the key lives in the
# pay-link URL fragment (#k=...) and is never sent to the API. This is a server-side field-integrity
# secret used only to HMAC-verify blobs, not to decrypt them.
BLOB_INTEGRITY_SECRET=

# CORS
WEB_ORIGIN=http://localhost:3000
